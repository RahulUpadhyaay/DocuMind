# Application Settings
ENVIRONMENT=production
PROJECT_NAME="Enterprise Document Intelligence & RAG API"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-random-secure-secret-key"

# Database (PostgreSQL with pgvector)
# Render or Railway provides DATABASE_URL directly
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/rag_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Embeddings Engine
# Options: "fastembed" (100% Free, local CPU) or "openai"
EMBEDDING_PROVIDER="fastembed"
# Default FastEmbed model: BAAI/bge-small-en-v1.5 (dim: 384)
# Default OpenAI model: text-embedding-3-small (dim: 1536)
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384

# LLM Generation Provider
# Options: "openai" or "gemini"
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional Gemini support
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Reranker Engine
# Options: "flashrank" (Local CPU, zero cost) or "cohere"
RERANKER_PROVIDER="flashrank"
COHERE_API_KEY=""

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Security: Default Admin Tenant Master Key (for creating tenants)
MASTER_API_KEY="enterprise-super-secret-admin-key"
